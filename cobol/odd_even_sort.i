 05 t-a-e USAGE BINARY-LONG SIGNED OCCURS 65536 TIMES.
01 v-n USAGE BINARY-DOUBLE SIGNED.
PROCEDURE DIVISION USING t-a v-n.
 MOVE 0 TO v-done
 PERFORM UNTIL 1 = 2
 IF v-done = 0
 MOVE 1 TO f-1
 ELSE
 MOVE 0 TO f-1
 END-IF
 IF f-1 = 0
 EXIT PERFORM
 END-IF
 MOVE 1 TO v-done
 MOVE 1 TO v-start
 PERFORM UNTIL 1 = 2
 IF v-start >= 0
 MOVE 1 TO f-2
 ELSE
 MOVE 0 TO f-2
 END-IF
 IF f-2 = 0
 EXIT PERFORM
 END-IF
 MOVE v-start TO v-i
 PERFORM UNTIL 1 = 2
 COMPUTE w-1 = v-i + 1
 IF w-1 < v-n
 MOVE 1 TO f-3
 ELSE
 MOVE 0 TO f-3
 END-IF
 IF f-3 = 0
 EXIT PERFORM
 END-IF
 COMPUTE w-2 = v-i + 1
 MOVE t-a-e(w-2) TO w-3
 COMPUTE w-4 = v-i + 1
 COMPUTE w-5 = w-4 + 1
 MOVE t-a-e(w-5) TO w-6
 IF w-3 > w-6
 MOVE 1 TO f-4
 ELSE
 MOVE 0 TO f-4
 END-IF
 IF f-4 = 1
 COMPUTE w-7 = v-i + 1
 COMPUTE w-8 = v-i + 1
 COMPUTE w-9 = w-7 + 1
 MOVE t-a-e(w-8) TO w-10
