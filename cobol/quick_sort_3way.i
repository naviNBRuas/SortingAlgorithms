 END-IF
 IF f-2 = 0
 EXIT PERFORM
 END-IF
 COMPUTE w-5 = v-i + 1
 MOVE t-a-e(w-5) TO w-6
 IF w-6 < v-pivot
 MOVE 1 TO f-3
 ELSE
