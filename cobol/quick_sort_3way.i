 END-IF
 IF f-3 = 1
 COMPUTE w-7 = v-lt + 1
 COMPUTE w-8 = v-i + 1
 MOVE t-a-e(w-7) TO w-9
 MOVE t-a-e(w-8) TO t-a-e(w-7)
 MOVE w-9 TO t-a-e(w-8)
 COMPUTE w-10 = v-lt + 1
 MOVE w-10 TO v-lt
 COMPUTE w-11 = v-i + 1
 MOVE w-11 TO v-i
 ELSE
 COMPUTE w-12 = v-i + 1
 MOVE t-a-e(w-12) TO w-13
 IF w-13 > v-pivot
 MOVE 1 TO f-4
 ELSE
 MOVE 0 TO f-4
 END-IF
 IF f-4 = 1
