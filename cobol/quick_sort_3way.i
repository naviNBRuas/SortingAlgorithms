PROCEDURE DIVISION USING t-a v-lo v-hi.
 PERFORM UNTIL 1 = 2
 IF v-lo < v-hi
 MOVE 1 TO f-1
 ELSE
 MOVE 0 TO f-1
 END-IF
 IF f-1 = 0
 EXIT PERFORM
 END-IF
 COMPUTE w-1 = v-lo + v-hi
 COMPUTE w-2 = FUNCTION INTEGER-PART(w-1 / 2)
 COMPUTE w-3 = w-2 + 1
 MOVE t-a-e(w-3) TO w-4
 MOVE w-4 TO v-pivot
 MOVE v-lo TO v-lt
