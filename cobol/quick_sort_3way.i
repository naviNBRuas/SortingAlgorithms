 COMPUTE w-15 = v-gt + 1
 MOVE t-a-e(w-14) TO w-16
 MOVE t-a-e(w-15) TO t-a-e(w-14)
 MOVE w-16 TO t-a-e(w-15)
 COMPUTE w-17 = v-gt - 1
 MOVE w-17 TO v-gt
 ELSE
 COMPUTE w-18 = v-i + 1
 MOVE w-18 TO v-i
 END-IF
 END-IF
 END-PERFORM
 COMPUTE w-19 = v-lt - v-lo
 COMPUTE w-20 = v-hi - v-gt
 IF w-19 < w-20
 MOVE 1 TO f-5
 ELSE
 MOVE 0 TO f-5
 END-IF
 IF f-5 = 1
 COMPUTE w-21 = v-lt - 1
 CALL "qs3092-qs" USING BY REFERENCE t-a BY CONTENT v-lo BY CONTENT w-21
 END-CALL
 COMPUTE w-22 = v-gt + 1
 MOVE w-22 TO v-lo
 ELSE
 COMPUTE w-23 = v-gt + 1
 CALL "qs3092-qs" USING BY REFERENCE t-a BY CONTENT w-23 BY CONTENT v-hi
 END-CALL
 COMPUTE w-24 = v-lt - 1
 MOVE w-24 TO v-hi
 END-IF
 END-PERFORM
 GOBACK.
END PROGRAM qs3092-qs.

